cabal-version:      3.0
name:               generator
version:            0.1.0.0
author:             Janik Eriksson
maintainer:         eriksson@wifa.uni-leipzig.de

library
  exposed-modules:
      Generator.Helper,
      Generator.Configuration,
      Generator.ParseResult,
      Generator,
      Generator.ParserUtils,
      Generator.Atoms,
      Generator.ParameterParser.AST,
      Generator.ParameterParser,

  other-modules:
      Generator.ParseResult.Type,
      Generator.ParseResult.Info,
      Generator.ParseResult.FromAST,
      Generator.ToParseResult,
      Generator.Configuration.Type,
      Generator.Configuration.FromParseResult,
      Generator.Configuration.Internal,
      Generator.Test,
      Generator.App,
      Generator.Globals,
      Generator.CmdArgs,
      Generator.Main,
      Generator.Interactive
  
  build-depends:
      base,
      megaparsec,
      xml,
      containers,
      filepath,
      text,
      transformers,
      directory,
      microlens,
      microlens-th,
      pretty-simple,
      split,
      optparse-applicative,
      random,
      HUnit,
      extra,
      mtl,

  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions: 
      FlexibleInstances,
      ImportQualifiedPost,
      OverloadedRecordDot,
      DuplicateRecordFields,
      RankNTypes,
      ImportQualifiedPost,
      FlexibleContexts

test-suite test-generator
    type: exitcode-stdio-1.0
    main-is: Generator/Test.hs
    hs-source-dirs: test
    ghc-options: -main-is Generator.Test.main
    -- ghc-options: necessary because https://stackoverflow.com/questions/46895199/no-output-will-be-generated-because-there-is-no-main-module#comment92924470_46895256
    build-depends:
      base,
      QuickCheck,
      generator
    default-language: Haskell2010
    
